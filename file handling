//WRITING to a file
int main()
{
    FILE *fp;
    fp= fopen("C.txt","w");
    if(fp==NULL)
    {
        printf("file cannot be opened");
        return 1;
    }
    fprintf(fp,"Hello,world!");
    fclose(fp);
    printf("Data written successfully.");
    return 0;
}

