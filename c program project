#include <stdio.h>
#include<string.h>
int main()
       {
           int n, cons_no, phase, units, choice;
           char name[50];
           double load, duty, fixed=0, demand=0, energy=0, total;
           
           printf("**********************************************************\n");
           printf("                 EB Bill Calculation\n");
           printf("**********************************************************\n");
           printf("\n");
           printf("            Enter the data of the consumer\n");
           printf("\n");
           
           printf("Enter the number of data entries =");
           scanf("%d",&n);
           
           for(int i=1;i<=n;i++){
                  fixed=0;demand=0;duty=0;energy=0;total=0;
                  printf("\n Enter the Consumer No:");
                  scanf("%d",&cons_no);
                  
                  printf("\n Enter the Name:");
                  scanf("%s",name);
                  
                  printf("\n Select Category:\n"); 
                  printf("1.House(Single phase)\n");
                  printf("2.LT Commercial(LT-V)\n");
                  printf("3.LT Industrial(LT-III B)\n");
                  printf("4.HT Industrial\n");
                  printf("Enter Choice:");
                  scanf("%d",&choice);
                  
                  printf("\n Enter the Units consumed:");
                  scanf("%d",&units);
                  
                  
                // 1.HOUSE
                  
                  if(choice==1){
                    if(units<=500){
                       if(units>200 && units<=400)
                             energy=(units-200)*4.70;
                        else if(units>400 && units<=500)
                             energy=(200*4.70)+(units-400)*6.30;
                    }else{ 
                        if(units<=600)
                              energy=(300*4.70)+(100*6.30)+(units-500)*8.40;
                         else if(units<=800)
                              energy=(300*4.70)+(100*6.30)+(100*8.40)+(units-600)*9.45;
                         else if(units<=1000)
                               energy=(300*4.70)+(100*6.30)+(100*8.40)+(200*9.45)+(units-800)*10.50;
                         else 
                              energy=(300*4.70)+(100*6.30)+(100*8.40)+(200*9.45)+(200*10.50)+(units-1000)*11.55;
                         }
                    }
                      
                //2. LT COMMERCIAL
                       else if(choice==2){
                           printf("Enter the load(kW):");
                          scanf("%lf",&load);
                           if(units<=100)
                               energy=units*6.65;
                            else
                               energy=units*10.45;
                            fixed=load*110;    
                            duty=energy*0.05;  
                            
                       }
                       
                       
                //3. LT INDUSTRIAL
                      else if(choice==3){
                          energy=units*8.25;
                          duty=energy*0.05;
                      }
            
                      
                //4. HT INDUSTRIAL          
                       else if(choice==4){
                          printf("Enter the Demand load(kW):");
                          scanf("%lf",&load);
                            energy=units*7.50;
                            demand=load*100;
                       }
                           total=fixed+demand+duty+energy;
                          
                          printf("\n---------------BILL FOR %s---------------\n",name);
                          printf("Energy Charge  : Rs. %.2lf\n",energy);
                          if(choice==2){
                          printf("Fixed Charge  : Rs. %.2lf\n",fixed);
                          printf("Electricity Duty : Rs. %.2lf\n",duty);
                        }  
                          if(choice==3){
                          printf("Electricity Duty : Rs.%.2lf\n",duty);      
                          }
                        
                         if(choice==4){
                          printf("Demand Charge : Rs. %.2lf\n",demand);
                        }
                          printf("TOTAL BILL   : Rs.  %.2lf\n",total);
                          printf("-------------------------------------------\n");
                       }                  
                         return 0;
            }          
